import os
import tempfile
import torch
from spark_runtime.native_packed_loader import load_native_packed_loader
native = load_native_packed_loader()
storage = torch.arange(64, dtype=torch.uint8)
a = torch.empty(4, dtype=torch.int32)
b = torch.empty(8, dtype=torch.uint8)
plan = native.ExpertCopyPlan([0, 16], [16, 8])
copied = plan.copy_storage_to_tensors(storage, [a, b], False)
assert copied == 24, copied
assert torch.equal(a.view(torch.uint8), storage[:16])
assert torch.equal(b, storage[16:24])
with tempfile.NamedTemporaryFile(delete=False) as handle:
    path = handle.name
    handle.write(bytes(range(64)))
fd = os.open(path, os.O_RDONLY)
try:
    staging = torch.empty(64, dtype=torch.uint8)
    c = torch.empty(4, dtype=torch.int32)
    d = torch.empty(8, dtype=torch.uint8)
    read_bytes, copied_bytes, read_seconds, copy_seconds = plan.read_into_and_copy(fd, staging, 64, 0, [c, d], False)
finally:
    os.close(fd)
    os.unlink(path)
assert read_bytes == 64, read_bytes
assert copied_bytes == 24, copied_bytes
assert torch.equal(c.view(torch.uint8), storage[:16])
assert torch.equal(d, storage[16:24])
print({"copied": copied, "read_bytes": read_bytes, "copy_seconds": copy_seconds, "plan_count": plan.count})
